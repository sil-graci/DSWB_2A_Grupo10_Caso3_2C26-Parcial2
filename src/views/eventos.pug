extends layout

block content
  .section-header.section-header--acciones
    p.section-label PANEL DE EVENTOS
    h2.section-title Eventos disponibles
    p.section-description
      | Consultá los eventos disponibles y la información de cada uno.
    if usuario && usuario.rol === "admin"
      a.boton.boton--nuevo(href="/eventos/nuevo") + Crear nuevo evento

  if mensaje
    p#mensaje-exito.mensaje-exito= mensaje
    script.
      history.replaceState(null, "", "/eventos/vista");
      setTimeout(() => {
        const mensaje = document.getElementById("mensaje-exito");
        if (!mensaje) return;
        mensaje.classList.add("mensaje-exito--oculto");
        setTimeout(() => mensaje.remove(), 500);
      }, 4000);

  .filtros-eventos
    button#btnTodos.boton(type="button") Todos
    button#btnProximos.boton(type="button") Próximos eventos

  .eventos-grid#listaEventos(data-rol=usuario ? usuario.rol : "")

  script(src="/js/eventos.js")
