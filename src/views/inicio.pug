extends layout

block content
  .inicio
    header.portada-header
      a.portada-marca(href="/")
        span URBANA
        span CULT

      if usuario
        .portada-cuenta
          a.inicio-boton(href="/eventos/vista") Ver eventos
          form(action="/logout", method="POST")
            button.inicio-boton(type="submit") Salir
      else
        a.inicio-boton(href="/login") Ingresar

    section.inicio-hero
      .inicio-hero__contenido
        h2 Cultura urbana,
          br
          | espacios para todos.

        button.inicio-boton#mostrar-cartelera(
          type="button"
          aria-controls="cartelera"
          aria-expanded="false"
        ) Conocé más

    section.cartelera#cartelera(hidden)
      .cartelera-encabezado
        div
          p Próximos encuentros
          h2 Descubrí nuestra programación

      if errorCartelera
        p= errorCartelera
      else if eventos.length === 0
        p No hay eventos activos próximos disponibles.
      else
        .cartelera-marco
          button.cartelera-flecha.cartelera-flecha--izquierda(
            type="button"
            data-direccion="-1"
            aria-label="Ver eventos anteriores"
            aria-controls="lista-espectaculos"
          ) ❮

          .cartelera-lista#lista-espectaculos(
            tabindex="0"
            role="region"
            aria-label="Eventos disponibles"
          )
            each evento in eventos
              article.espectaculo
                img(
                  src=evento.imagen || "/portada.png"
                  alt=evento.titulo
                  loading="lazy"
                  onerror="this.onerror=null;this.src='/portada.png'"
                )

                .espectaculo-contenido
                  span.espectaculo-tipo Activo
                  h3= evento.titulo
                  p= evento.descripcion

                  details.espectaculo-detalles
                    summary Ver más
                    p Fecha: #{evento.fecha}
                    p Hora: #{evento.hora}
                    p Sala: #{evento.nombreSala}
                    if Number.isFinite(evento.precio) && evento.precio > 0
                      - const precioARS = "$" + evento.precio.toLocaleString("es-AR") + " ARS"
                      - const tieneUSD = Number.isFinite(evento.precioUSD)
                      - const precioUSD = tieneUSD ? "USD " + evento.precioUSD.toLocaleString("es-AR", { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + (evento.usaUltimaCotizacion ? " · Última cotización disponible" : "") : ""
                      .espectaculo-monedas(role="group" aria-label="Moneda del precio")
                        button.boton.boton--chico(type="button" aria-pressed="true" data-precio=precioARS) Pesos
                        = " "
                        button.boton.boton--chico.boton--secundario(type="button" aria-pressed="false" data-precio=precioUSD disabled=!tieneUSD) Dólares
                      if !tieneUSD
                        p Cotización en dólares no disponible.
                      p
                        strong Entrada:
                        = " "
                        span(data-precio-visible aria-live="polite")= precioARS
                    else if evento.precio === 0
                      p
                        strong Gratis
                    else
                      p Precio no informado

                  if usuario
                    a.boton(
                      href="/entradas/nueva/" + evento._id
                    ) Comprar entrada
                  else
                    a.boton(href="/login") Iniciá sesión para comprar

          button.cartelera-flecha.cartelera-flecha--derecha(
            type="button"
            data-direccion="1"
            aria-label="Ver siguientes eventos"
            aria-controls="lista-espectaculos"
          ) ❯

    script.
      (() => {
        const botonMostrar =
          document.querySelector("#mostrar-cartelera");

        const cartelera =
          document.querySelector("#cartelera");

        const lista =
          document.querySelector("#lista-espectaculos");

        const flechas =
          document.querySelectorAll(".cartelera-flecha");

        const reducirMovimiento = window.matchMedia(
          "(prefers-reduced-motion: reduce)"
        );

        botonMostrar.addEventListener("click", () => {
          cartelera.hidden = false;
          botonMostrar.setAttribute("aria-expanded", "true");

          cartelera.scrollIntoView({
            behavior: reducirMovimiento.matches
              ? "auto"
              : "smooth",
            block: "start"
          });
        });

        if (!lista) return;

        lista.addEventListener("click", (event) => {
          const boton = event.target.closest(".espectaculo-monedas button");
          if (!boton) return;

          const grupo = boton.closest(".espectaculo-monedas");
          const precio = grupo.closest("details").querySelector("[data-precio-visible]");
          precio.textContent = boton.dataset.precio;

          grupo.querySelectorAll("button").forEach((opcion) => {
            opcion.setAttribute("aria-pressed", String(opcion === boton));
            opcion.classList.toggle("boton--secundario", opcion !== boton);
          });
        });

        flechas.forEach((flecha) => {
          flecha.addEventListener("click", () => {
            const tarjeta =
              lista.querySelector(".espectaculo");

            if (!tarjeta) return;

            const separacion =
              parseFloat(getComputedStyle(lista).gap) || 0;

            const distancia =
              tarjeta.getBoundingClientRect().width +
              separacion;

            const direccion =
              Number(flecha.dataset.direccion);

            const limite = Math.max(
              0,
              lista.scrollWidth - lista.clientWidth
            );

            let destino =
              lista.scrollLeft + direccion * distancia;

            if (
              direccion === 1 &&
              lista.scrollLeft >= limite - 2
            ) {
              destino = 0;
            } else if (
              direccion === -1 &&
              lista.scrollLeft <= 2
            ) {
              destino = limite;
            }

            lista.scrollTo({
              left: destino,
              behavior: reducirMovimiento.matches
                ? "auto"
                : "smooth"
            });
          });
        });
      })();