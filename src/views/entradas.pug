extends layout

block content
  .section-header.section-header--acciones
    p.section-label PANEL DE ENTRADAS
    h2.section-title Mis entradas
    p.section-description
      | Consultá las entradas y la información de cada evento.

  if usuario && usuario.rol === "admin"
    .filtros-eventos
      input#filtroDni(type="search" placeholder="Buscar por DNI del cliente" aria-label="Buscar por DNI del cliente")
      button#btnTodasEntradas.boton(type="button") Todas las entradas
      button#btnEntradasActivas.boton(type="button") Eventos activos

  p#mensajeEntradas.mensaje-aviso
  p#sinEntradas.section-description
  #listaEntradas.eventos-grid(data-rol=usuario ? usuario.rol : "")

  if usuario && usuario.rol === "admin"
    dialog#dialogEditarEntrada.dialogo-entrada
      form#formEditarEntrada.formulario-evento
        h2.section-title Modificar entrada
        .campo
          label(for="estadoEntrada") Estado
          select#estadoEntrada(name="estado" required)
            option(value="activa") Activa
            option(value="cancelada") Cancelada
            option(value="usada") Usada
        p#mensajeEditarEntrada.mensaje-error
        .formulario-evento__acciones
          button#cancelarEdicionEntrada.boton.boton--secundario(type="button") Cancelar
          button.boton(type="submit") Guardar cambios

  script(src="/js/entradas.js" defer)
