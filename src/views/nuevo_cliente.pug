extends layout

block content
  .section-header
    p.section-label PANEL DE CLIENTES

    h2.section-title= cliente ? "Modificar cliente" : "Registrar cliente"

    p.section-description
      if cliente
        | Modificá los datos del cliente seleccionado.
      else
        | Completá los datos para registrar un nuevo cliente.

  form#form-cliente.formulario-evento(
    data-id=cliente ? cliente._id : ""
  )
    .campo
      label(for="nombre") Nombre
      input#nombre(
        type="text"
        name="nombre"
        value=cliente ? cliente.nombre : ""
      )

    .campo
      label(for="apellido") Apellido
      input#apellido(
        type="text"
        name="apellido"
        value=cliente ? cliente.apellido : ""
      )
  
    .campo
      label(for="dni") DNI
      input#dni(
        type="text"
        name="dni"
        value=cliente ? cliente.dni : ""
        placeholder="12345678"
        pattern="[0-9]{8}"
        maxlength="8"
        minlength="8"
        title="Ingrese un DNI de 8 dígitos"
        required
      )
      
    .campo
      label(for="email") Email
      input#email(
        type="email"
        name="email"
        value=cliente ? cliente.email : ""
        required
      )

    .campo
      label(for="telefono") Teléfono
      input#telefono(
        type="tel"
        name="telefono"
        value=cliente ? cliente.telefono : ""
        pattern="[0-9]{8,15}"
        minlength="8"
        maxlength="15"
        title="Ingrese entre 8 y 15 números"
      )

    p#mensaje-formulario.mensaje-error-cliente

    .formulario-evento__acciones
      a.boton.boton--secundario(
        href="/clientes/vista"
      )
        | Cancelar

      button.boton.boton-formulario(type="submit")= cliente ? "Guardar cambios" : "Guardar cliente"

  script(src="/js/cliente-form.js")