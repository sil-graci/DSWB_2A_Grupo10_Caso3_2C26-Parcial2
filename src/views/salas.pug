extends layout

block content
  .section-header.section-header--acciones
    p.section-label PANEL DE SALAS
    h2.section-title Salas disponibles
    p.section-description
      | Consultá las salas registradas y su capacidad.
    a.boton.boton--nuevo(href="/salas/nuevo") + Nueva Sala

  if mensaje
    p.mensaje-exito= mensaje

  p#mensaje-salas

  
  #lista-salas.eventos-grid

  script(src="/js/salas.js" defer)
      