extends layout

block content
  if registrado
    script.
      alert("¡Cuenta creada exitosamente!\n" +
       "Contraseña temporal: 1234\n" +
      "Por seguridad, se recomienda cambiarla cuando esa opción esté disponible");
  .login-wrapper
    .login-card
      h1 Iniciar sesión

      form(action="/login", method="POST")
        label(for="email") Email
        input#email(type="email", name="email", required)

        label(for="password") Contraseña
        input#password(type="password", name="password", required)

        button(type="submit") Entrar
        p
          | ¿No tienes una cuenta? 
          a(href="/clientes/nuevo") Regístrate