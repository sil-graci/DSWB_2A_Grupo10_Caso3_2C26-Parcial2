doctype html
html
  head
    title Login
  body
    h1 Iniciar sesión

    form(action="/login", method="POST")
      label Email:
      input(type="email", name="email", required)
      br
      label Password:
      input(type="password", name="password", required)
      br
      button(type="submit") Entrar

    form(action="/registro", method="POST")
      label Email:
      input(type="email", name="email", required)
      br
      label Password:
      input(type="password", name="password", required)
      br
      button(type="submit") Registrarse