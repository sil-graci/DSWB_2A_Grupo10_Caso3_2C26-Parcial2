extends layout

block content
  .section-header.section-header--acciones
    p.section-label PANEL DE CLIENTES
    h2.section-title Clientes registrados

    p.section-description
      | Consultá la información de los clientes registrados.

    p#contador-clientes.evento-card__codigo
      | Cargando clientes...

    
    .filtros-eventos
      input#buscar-cliente(
        type="search"
        placeholder="Buscar cliente por nombre, apellido, DNI o email"
        aria-label="Buscar cliente"
      )

      button#btn-activos.boton(
        type="button"
      ) Activos

      button#btn-todos.boton(
        type="button"
      ) Todos
    
    p#mensaje-clientes

    a.boton.boton--nuevo(href="/clientes/nuevo")
      | + Nuevo Cliente

  if mensaje
    p#mensaje-exito.mensaje-exito= mensaje

    script.
      history.replaceState(null, "", "/clientes/vista");

      setTimeout(() => {
        const mensaje =
          document.getElementById("mensaje-exito");

        if (!mensaje) return;

        mensaje.classList.add(
          "mensaje-exito--oculto"
        );

        setTimeout(
          () => mensaje.remove(),
          500
        );
      }, 4000);

  

  .eventos-grid#lista-clientes

  script(src="/js/clientes.js")