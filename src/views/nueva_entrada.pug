extends layout

block content
  .section-header
    p.section-label COMPRA DE ENTRADAS
    h2.section-title= evento.titulo
    p.section-description
      | Seleccioná el cliente que va a comprar la entrada para este evento.

  form#formCompraEntrada.formulario-evento(action="/entradas" method="POST")
    input(type="hidden" name="eventoId" value=evento._id)

    if usuario && usuario.rol === "admin"
      .campo
        label(for="clienteId") Cliente
        select#clienteId(name="clienteId" required)
          option(value="" disabled selected) Seleccioná un cliente
          each cliente in clientes
            option(value=cliente._id)= `${cliente.nombre} ${cliente.apellido}`
    else if usuario && usuario.rol === "visitante" && cliente
      .campo
        label(for="clienteNombre") Cliente
        input#clienteNombre(type="text" value=[cliente.nombre, cliente.apellido].filter(Boolean).join(" ") readonly)
        input(type="hidden" name="clienteId" value=cliente._id)

    if usuario && (usuario.rol === "admin" || (usuario.rol === "visitante" && cliente))
      .campo
        label(for="cantidad") Cantidad de entradas
        input#cantidad(type="number" name="cantidad" min="1" step="1" value="1" required)

      p#mensajeCompra.mensaje-error
      a#verEntradas.boton(href="/entradas/vista" hidden) Ver mis entradas

      .formulario-evento__acciones
        a.boton.boton--secundario(href="/eventos/vista") Cancelar
        button.boton(type="submit" disabled=usuario.rol === "admin" && clientes.length === 0) Comprar entradas

      if usuario.rol === "admin" && clientes.length === 0
        p.section-description No hay clientes registrados para seleccionar.
    else if usuario && usuario.rol === "visitante"
      p.section-description No encontramos un cliente asociado a tu usuario.

  script(src="/js/nueva_entrada.js" defer)
